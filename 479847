local function purgeCloverInstance(obj)
    if not Config.DisableClover and not Config.DisableAllParticles then return end
    if not obj:IsA("ParticleEmitter") and not obj:IsA("Trail") and not obj:IsA("Beam") and not obj:IsA("ImageLabel") and not obj:IsA("ImageButton") then return end

    pcall(function()
        if obj:IsA("ParticleEmitter") then
            if Config.DisableAllParticles then
                obj.Enabled = false
                obj.Rate = 0
                pcall(function() obj:Clear() end)
                return
            end

            local name = string.lower(obj.Name or "")
            local pName = string.lower(obj.Parent and obj.Parent.Name or "")
            local tex = string.lower(obj.Texture or "")

            local isMatch = false
            if string.find(name, "clover") or string.find(pName, "clover") or string.find(tex, "clover")
                or string.find(name, "luck") or string.find(pName, "luck")
                or string.find(name, "leaf") or string.find(pName, "leaf")
                or string.find(name, "vine") or string.find(pName, "vine")
                or string.find(name, "rain") or string.find(pName, "rain")
                or string.find(name, "weather") or string.find(pName, "weather")
                or string.find(name, "ambient") or string.find(pName, "ambient")
                or string.find(name, "草") or string.find(name, "叶") or string.find(name, "藤") or string.find(name, "幸运") then
                isMatch = true
            end

            if not isMatch and Workspace.CurrentCamera and obj:IsDescendantOf(Workspace.CurrentCamera) then
                isMatch = true
            end

            if not isMatch and obj.Color then
                local kp = obj.Color.Keypoints
                if kp and #kp > 0 then
                    local c = kp[1].Value
                    if c.G > 0.4 and c.G > (c.R * 1.15) and c.G > (c.B * 1.15) then
                        isMatch = true
                    end
                end
            end

            if isMatch then
                obj.Enabled = false
                obj.Rate = 0
                pcall(function() obj:Clear() end)
            end
        elseif obj:IsA("Trail") or obj:IsA("Beam") then
            local name = string.lower(obj.Name or "")
            local pName = string.lower(obj.Parent and obj.Parent.Name or "")
            if Config.DisableAllParticles or string.find(name, "clover") or string.find(pName, "clover") or string.find(name, "leaf") or string.find(name, "vine") then
                obj.Enabled = false
            end
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            local name = string.lower(obj.Name or "")
            local pName = string.lower(obj.Parent and obj.Parent.Name or "")
            local img = string.lower(obj.Image or "")
            if string.find(name, "clover") or string.find(pName, "clover") or string.find(img, "clover")
               or string.find(name, "luck") or string.find(pName, "luck")
               or string.find(name, "leaf") or string.find(pName, "leaf")
               or string.find(name, "草") or string.find(pName, "草") then
                obj.Visible = false
            end
        end
    end)
end

