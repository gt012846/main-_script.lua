local lastStarShopBuyTime = 0

local function getStarCoinBalance()
    local starCoins = 0

    -- 1. ดึงจาก WuKong Query โดยตรง (เร็วและแม่นยำที่สุด)
    pcall(function()
        local WuKong = require(ReplicatedStorage.WuKong)
        if WuKong and WuKong.ExecuteQuery then
            local res = WuKong:ExecuteQuery("/货币/许愿星代币?属性数量")
            if res and tonumber(res) then
                starCoins = math.max(starCoins, tonumber(res) or 0)
            end
        end
    end)

    -- 2. ดึงจาก ActivityEvent State
    pcall(function()
        local ActivityEventState = require(ReplicatedStorage.UI.ActivityEvent.Model.State)
        if ActivityEventState then
            if ActivityEventState.RefreshWishCurrencyBalance then
                ActivityEventState:RefreshWishCurrencyBalance()
            end
            local bal = ActivityEventState:GetWishCurrencyBalance()
            if bal and tonumber(bal) then
                starCoins = math.max(starCoins, tonumber(bal) or 0)
            end
        end
    end)

    -- 3. ตรวจสอบจาก GUI บนหน้าจอ (PlayerGui.HUDContainer.ActivityEvent)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local act = pg and pg:FindFirstChild("HUDContainer") and pg.HUDContainer:FindFirstChild("ActivityEvent")
        if act then
            for _, desc in ipairs(act:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Visible then
                    local txt = desc.Text or ""
                    local num = string.match(txt, "Your Star Coin:%s*(%d+)") or (string.find(txt, "Star Coin") and string.match(txt, "(%d+)"))
                    if num and tonumber(num) then
                        starCoins = math.max(starCoins, tonumber(num) or 0)
                    end
                end
            end
        end
    end)

    return starCoins
end

local function buyStarShopItem(productId, productName, cost)
