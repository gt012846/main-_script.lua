local function registerPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    local name = prompt.Name
    local objText = string.lower(prompt.ObjectText or "")
    local actText = string.lower(prompt.ActionText or "")

    -- Strawberry King Event Coins
    if string.find(objText, "strawberry") or name == "ActivityCoinPrompt" or (string.find(objText, "coin") and string.find(actText, "pick")) then
        cachedStrawberryCoinPrompts[prompt] = true
        cachedCoinPrompts[prompt] = true
        -- มีเหรียญเกิดใหม่ให้รีบไปเก็บเรื่อยๆ ทันที (มี Debounce ป้องกันสแปม Coroutine ซ้อนกัน)
        if Config.AutoSweepStrawberryCoins then
            requestSweepStrawberryCoins()
        end
    elseif name == "ClaimRolledAntPrompt" then
        cachedClaimPrompts[prompt] = true
    elseif prompt.ActionText == "Get" or (prompt.Parent and prompt.Parent.Name == "Prompt") then
        cachedFoodGetPrompts[prompt] = true
    elseif prompt.Parent and prompt.Parent.Name == "SellPrompt" then
        cachedFoodSellPrompts[prompt] = true
    elseif (prompt.Parent and prompt.Parent.Name == "Rubbish") or prompt.ActionText == "Give Up" or string.find(actText, "give up") then
        cachedRubbishPrompts[prompt] = true
    else
        local act = string.lower(prompt.ActionText or "")
        local pName = string.lower(prompt.Parent and prompt.Parent.Name or "")

        -- แยกแยะอย่างชัดเจนระหว่าง ถ้ำดันเจี้ยนสัตว์เลี้ยง (Pet Dungeon Cave) vs น้ำพุดาวตก (Starfall) vs หอยทาก (Travel Snail)
        local isPetDungeon = false
        local petDungeonModel = nil
        local isStar = false
        local isSnail = false

        local curr = prompt.Parent
        while curr and curr ~= Workspace do
            local cName = string.lower(curr.Name)
            if curr:GetAttribute("DungeonEntranceId") or cName == "dungeonentrances" or string.find(cName, "petdungeon") then
                isPetDungeon = true
                if curr:IsA("Model") and (curr:GetAttribute("DungeonEntranceId") or string.find(cName, "petdungeon")) then
                    petDungeonModel = curr
                end
                break
            elseif string.find(cName, "starevent") or string.find(cName, "starfall") then
                isStar = true
                break
            elseif string.find(cName, "travelsnail") or string.find(cName, "snail") or string.find(cName, "travel") or string.find(cName, "蜗牛") then
                isSnail = true
                break
            end
            curr = curr.Parent
        end

        if not isPetDungeon and not isStar and not isSnail then
            local pPart = prompt.Parent
            if pPart and pPart:IsA("BasePart") then
                local dist = (pPart.Position - FOUNTAIN_PAD_CFRAME.Position).Magnitude
                if dist <= 45 then
                    isStar = true
                end
            end
            if prompt.Parent and prompt.Parent.Parent then
                local ancestor = prompt.Parent.Parent
                if ancestor:GetAttribute("DungeonEntranceId") or ancestor:FindFirstChild("DungeonGui") then
                    isPetDungeon = true
                    petDungeonModel = ancestor
                end
            end
        end

        if isPetDungeon then
            if string.find(act, "enter") or string.find(pName, "promt") or string.find(pName, "enter") or name == "Enterpromt" or name == "ProximityPrompt" then
                cachedPetDungeonPrompts[prompt] = petDungeonModel or prompt.Parent
            end
        elseif isStar then
            if string.find(act, "flip") or string.find(pName, "flip") or (string.find(act, "star") and string.find(pName, "promt")) then
                cachedFlipPrompt = prompt
            elseif string.find(act, "enter") or string.find(pName, "enter") or name == "Enterpromt" then
                cachedStarEnterPrompt = prompt
            end
        elseif isSnail or string.find(objText, "snail") or string.find(actText, "snail") then
            if string.find(act, "enter") or string.find(pName, "enter") then
                cachedSnailEnterPrompt = prompt
            end
        else
            if string.find(act, "flip") or string.find(pName, "flip") then
                cachedFlipPrompt = prompt
            elseif string.find(act, "enter") or string.find(pName, "enter") then
                local pPart = prompt.Parent
                if pPart and pPart:IsA("BasePart") and (pPart.Position - FOUNTAIN_PAD_CFRAME.Position).Magnitude <= 45 then
                    cachedStarEnterPrompt = prompt
                else
                    cachedSnailEnterPrompt = prompt
                end
            end
        end
    end
end

