-- 9.5.0. DYNAMIC DUNGEON COOLDOWN & NEW DUNGEON DETECTION
-- ══════════════════════════════════════════════════════════════════
local lastChallengedDungeonPrompt = nil
local lastChallengedDungeonTime = 0
local dungeonAlreadyChallengedActive = false

getDungeonCooldownSeconds = function()
    -- 1. ตรวจสอบ NextActivityCountdownSeconds จาก Workspace (เวลาเริ่มกิจกรรมรอบถัดไป เช่น 2:42 = 162 วิ)
    local nextCd = tonumber(Workspace:GetAttribute("NextActivityCountdownSeconds") or 0) or 0
    if nextCd > 0 then
        return nextCd
    end

    -- 2. ตรวจสอบ CurrentActivityCountdownSeconds จาก Workspace
    local curCd = tonumber(Workspace:GetAttribute("CurrentActivityCountdownSeconds") or 0) or 0
    if curCd > 0 then
        return curCd
    end

    -- 3. ตรวจสอบ ClockTimer บนหัวน้ำพุ (Direct path: เร็วระดับ O(1) ไม่ใช้ GetDescendants)
    local parsedFountainClock = nil
    pcall(function()
        local starModel = Workspace:FindFirstChild("StarEvent")
        if starModel then
            local clockLbl = starModel:FindFirstChild("ClockTimer", true)
            if clockLbl and clockLbl:IsA("TextLabel") and clockLbl.Visible then
                local m, s = string.match(clockLbl.Text, "(%d+):(%d+)")
                if m and s then
                    local secs = tonumber(m) * 60 + tonumber(s)
                    if secs > 0 then
                        parsedFountainClock = secs
                    end
                end
            end
        end
    end)
    if parsedFountainClock and parsedFountainClock > 0 then
        return parsedFountainClock
    end

    -- 4. ตรวจสอบ TextLabel ในหน้าจอ HUD จาก Direct path (ไม่ใช้ GetDescendants ทั้ง PlayerGui)
    local parsedHudClock = nil
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local hud = pg and pg:FindFirstChild("HUDContainer")
        local panel = hud and hud:FindFirstChild("HUDPanel")
        local top = panel and panel:FindFirstChild("Top")
        local actTime = top and top:FindFirstChild("ActivityTime")
        local lbl = actTime and actTime:FindFirstChild("ActivityTimeLabel")
        if lbl and lbl:IsA("TextLabel") and lbl.Visible then
            local m, s = string.match(lbl.Text, "(%d+):(%d+)")
            if m and s then
                local secs = tonumber(m) * 60 + tonumber(s)
                if secs > 0 then
                    parsedHudClock = secs
                end
            end
        end
    end)
    if parsedHudClock and parsedHudClock > 0 then
        return parsedHudClock
    end

    return Config.EventCooldownSeconds or 300
end

onDungeonAlreadyChallengedDetected = function(dungeonType, prompt)
    local targetType = dungeonType or lastAttemptedDungeonType or "StarEvent"
    local targetPrompt = prompt or lastAttemptedPrompt

    if targetType == "StarEvent" or (targetPrompt and targetPrompt == findStarEnterPrompt()) then
        dungeonAlreadyChallengedActive = true
        lastChallengedDungeonTime = os.clock()
        lastChallengedDungeonPrompt = targetPrompt or findStarEnterPrompt()
        Config.KaiTanPhase = "[ดันเจี้ยนติดสถานะ] ⚠️ ประตูดาวตกแจ้ง: You have already challenged the dungeon. (สลับไปลงดันอื่น หรือรอภาพประตูหายเพื่อรีเซ็ตทันที)"
    elseif targetType == "Pet" or (targetPrompt and targetPrompt:FindFirstAncestorWhichIsA("Model")) then
        local p = targetPrompt or (findPetDungeonPrompt and select(1, findPetDungeonPrompt()))
        if p then
            local model = p:FindFirstAncestorWhichIsA("Model")
            local entranceId = (model and model:GetAttribute("DungeonEntranceId")) or tostring(model or p)
            challengedPetDungeonIds[entranceId] = true
        end
        Config.KaiTanPhase = "[ดันเจี้ยนติดสถานะ] ⚠️ ถ้ำสัตว์เลี้ยงแจ้ง: You have already challenged the dungeon. (สลับไปลงดันอื่น)"
    else
        dungeonAlreadyChallengedActive = true
    end
end

-- Hook Alert ของระบบ เพื่อดักจับข้อความ "You have already challenged the dungeon." ทันที
pcall(function()
    local Alert = require(ReplicatedStorage.Packages.Neza.Alert)
    if Alert and Alert.Warn then
        local oldWarn = Alert.Warn
        Alert.Warn = function(msg, ...)
            if type(msg) == "string" and string.find(string.lower(msg), "already challenged") then
                onDungeonAlreadyChallengedDetected(lastAttemptedDungeonType, lastAttemptedPrompt)
            end
            return oldWarn(msg, ...)
        end
    end
end)

-- ตรวจสอบว่าภาพเอฟเฟกต์ประตูมิติดาวตก (Portal Vortex) ยังแสดงอยู่หรือไม่
-- ตัวเกม: เมื่อเปิดประตู Portal.Parent = StarEvent, เมื่อประตูปิด/ภาพประตูหาย Portal.Parent = nil
isStarPortalVortexVisible = function()
    local starModel = Workspace:FindFirstChild("StarEvent")
    if not starModel then return false end

    local portal = starModel:FindFirstChild("Portal")
    if not portal or portal.Parent ~= starModel then
        return false
    end

    -- ตรวจสอบว่ามีเอฟเฟกต์ภาพประตูเปิดทำงานอยู่จริงหรือไม่
    local hasVisual = false
    for _, desc in ipairs(portal:GetDescendants()) do
        if (desc:IsA("ParticleEmitter") and desc.Enabled) or (desc:IsA("Beam") and desc.Enabled) or (desc:IsA("PointLight") and desc.Enabled) then
            hasVisual = true
            break
        elseif (desc:IsA("MeshPart") or desc:IsA("BasePart")) and desc.Transparency < 0.9 then
            hasVisual = true
            break
        end
    end
    if not hasVisual then
        return false
    end

    -- ตรวจสอบ ClockTimer (ถ้าภาพประตูหาย ClockTimer จะซ่อนตัว และแสดง Count 0/30 แทน)
    local clockLbl = starModel:FindFirstChild("ClockTimer", true)
    if clockLbl and clockLbl.Visible then
        return true
    end

    return hasVisual
end

-- ตรวจสอบว่ามีดันใหม่เกิดหรือไม่ ("ถ้าสามารถลงดันอันไหนได้ให้ลงเลย ไม่ต้องจับเวลา")
isNewStarDungeonAvailable = function()
    -- 1. ถ้าภาพประตูหายไปแล้ว (Portal Vortex หาย) แปลว่ารอบดันเจี้ยนเดิมสิ้นสุดลงแล้ว!
    -- คูลดาวน์เสร็จสิ้นทันที พร้อมหยอดดาว 30 ดวงเตรียมลงซ้ำได้เลย!
    if not isStarPortalVortexVisible() then
        return true
    end

    local prompt = findStarEnterPrompt()
    if not prompt or not prompt.Parent or not prompt.Enabled then
        return false
    end

    -- 2. ถ้าไม่ได้ติดข้อความแจ้งเตือน "You have already challenged the dungeon." ก็ลงได้เลยทันที (ไม่ต้องจับเวลา)
    if not dungeonAlreadyChallengedActive then
        return true
    end

    -- 3. ถ้ามี Prompt ประตูมิติใหม่เกิดมา (ต่างจากตัวเดิมที่เคยโดนแจ้งเตือน)
    if lastChallengedDungeonPrompt and prompt ~= lastChallengedDungeonPrompt and prompt.Parent ~= lastChallengedDungeonPrompt.Parent then
        return true
    end

    return false
end

local function enterStarDungeon()
    -- ถ้าภาพประตูหายไปแล้ว แปลว่าประตูปิด/รอบเก่าจบแล้ว ไม่ต้องกด Enter แต่ให้ไปหยอดดาวแทน
    if not isStarPortalVortexVisible() then
        dungeonAlreadyChallengedActive = false
        lastChallengedDungeonPrompt = nil
        return false
    end

    local prompt = findStarEnterPrompt()
    if not prompt or not prompt.Enabled then return false end

    -- ถ้าเป็นดันเจี้ยนเดิมที่ติดข้อความแจ้งเตือน "You have already challenged the dungeon." และยังไม่รีเซ็ต ให้ข้ามไปลงดันอื่น
    if dungeonAlreadyChallengedActive and not isNewStarDungeonAvailable() then
        return false
    end

    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if not hrp then return false end

    local entered = false
    lastAttemptedDungeonType = "StarEvent"
    lastAttemptedPrompt = prompt

    pcall(function()
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 99999
        prompt.RequiresLineOfSight = false

        -- วาร์ปตัวละครเข้าไปในเสาประตูมิติน้ำพุดาวตกพอดี
        local pPart = prompt.Parent
        if pPart and pPart:IsA("BasePart") and (pPart.Position - FOUNTAIN_PAD_CFRAME.Position).Magnitude <= 50 then
            hrp.CFrame = pPart.CFrame + Vector3.new(0, 1.5, 0)
        else
            hrp.CFrame = FOUNTAIN_PAD_CFRAME
        end
        task.wait(0.15)

        triggerStarPrompt(prompt)

        -- ล็อกตัวละครไว้ที่ประตูมิติและรอจนกว่าเซิร์ฟเวอร์จะโหลดเข้าดันเจี้ยน (ป้องกันระบบอื่นแย่งวาร์ปตัวละครออกไป)
        local deadline = os.clock() + 2.5
        while os.clock() < deadline do
            local sess = LocalPlayer:GetAttribute("DungeonSessionId")
            if sess then
                entered = true
                lastDungeonTypeEntered = "StarEvent"
                Config.Stats.TotalDungeonsEntered = (Config.Stats.TotalDungeonsEntered or 0) + 1
                -- เข้าดันเจี้ยนได้ทันที ไม่ต้องจับเวลาหรือตั้งคูลดาวน์เวลาใดๆ
                pcall(function()
                    local EventBus = require(ReplicatedStorage.Packages.EventBus)
                    EventBus.Fire("DungeonStartRequested")
                    sendEcsCommand("DungeonCommand", { Action = "Start", SessionId = sess })
                end)
                return
            end

            -- ถ้าติดข้อความแจ้งเตือนว่าลงไปแล้ว ให้ออกจากลูปทันที
            if dungeonAlreadyChallengedActive then
                break
            end

            if hrp and prompt.Parent and prompt.Parent:IsA("BasePart") then
                hrp.CFrame = prompt.Parent.CFrame + Vector3.new(0, 1, 0)
            end
            triggerStarPrompt(prompt)
            task.wait(0.25)
        end
    end)

    if entered then
        return true
    end

    -- ตรวจสอบว่าติดข้อความ "You have already challenged the dungeon." หรือไม่
    if dungeonAlreadyChallengedActive then
        return false
    end

    -- สแกนดู Alert บนหน้าจอเฉพาะใน NezaAlertGui เพื่อความรวดเร็วและไม่กินสเปค
    pcall(function()
