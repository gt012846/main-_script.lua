                        task.wait(0.2)
                        if LocalPlayer:GetAttribute("DungeonSessionId") then
                            wasInDungeon = true
                            didEnterAnyDungeon = true
                            continue
                        end
                    end
                end
            end

            -- ตรวจสอบซื้อไอเทมร้านค้าอีเวนต์ดาวตก (Starwing Ant 2,400 เหรียญ)
            if Config.AutoBuyStarShop and checkAndBuyStarShopItems then
                pcall(checkAndBuyStarShopItems)
            end

            -- ══════════════════════════════════════════════════════════
            -- ─── STEP 2: HARVEST WORKER FOOD & SMART SELLING (ฟาร์มอาหาร & ขายปั๊มเงินสด) ───
            -- ══════════════════════════════════════════════════════════
            Config.KaiTanPhase = "[2/8] 🌾 เก็บอาหารคนงาน & ยกกล่องส่งขาย (Smart Multiplier)"
            sendEcsCommand("ClaimWorkerAntFood", {})
            pcall(function()
                for prompt in pairs(cachedCoinPrompts) do
                    if prompt and prompt.Parent and prompt.Enabled and fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                end
            end)
            pcall(function()
                pickUpFoodBox()
                local carried = tonumber(LocalPlayer:GetAttribute("CarriedSellFoodAmount") or LocalPlayer:GetAttribute("CarriedFoodAmount") or 0) or 0
                Config.CarriedFood = carried
                if carried > 0 or Config.CurrentMultiplier >= Config.TargetMultiplier then
                    sellFoodComplete()
                end
            end)
            task.wait(0.15)

            -- ══════════════════════════════════════════════════════════
            -- ─── STEP 3: TIMED WORLD ACTIVITIES & COIN SWEEPER (เหรียญพิเศษ & อีเวนต์โลก) ───
            -- ══════════════════════════════════════════════════════════
            -- 3.1 AutoSweepStrawberryCoins: เก็บเหรียญให้หมดเกลี้ยง ถ้ามีเหรียญเกิดใหม่ให้รีบไปเก็บเรื่อยๆ
            if Config.AutoSweepStrawberryCoins then
                local strawberryCoins = getAllAvailableStrawberryCoins()
                if #strawberryCoins > 0 then
                    Config.KaiTanPhase = string.format("[3/8] 🍓 เก็บเหรียญสตรอว์เบอร์รีให้หมด (%d เหรียญ)...", #strawberryCoins)
                    pcall(sweepStrawberryCoins)
                end
            end

            -- 3.2 Strawberry King Event (หมุนวงล้อ & ซื้อสกินมด ตามคูลดาวน์ 5 นาที)
            if Config.AutoStrawberryKing and not isEventOnCooldown("StrawberryKing") and isStrawberryKingActive() then
                Config.KaiTanPhase = "[3/8] 🍓 อีเวนต์ราชาสตรอว์เบอร์รี: สุ่มวงล้อ & ซื้อสกิน"
                pcall(automateStrawberryKingEvent)
                task.wait(0.2)
            -- 3.3 Travel Snail Event (หอยทากเร่: ตรวจสอบคูลดาวน์ 5 นาที ถ้าติดให้ข้ามทันที)
            elseif Config.AutoTravelSnail and not isEventOnCooldown("TravelSnail") and isTravelSnailActive() then
                Config.KaiTanPhase = "[3/8] 🐌 อีเวนต์หอยทากเร่: สุ่มรับของรางวัลบนก้อนหิน"
                pcall(automateTravelSnailEvent)
                task.wait(0.2)
            end

            -- ══════════════════════════════════════════════════════════
            -- ─── STEP 4: BASE & NEST PROGRESSION (อัปเกรดฐาน & รังมดขยายความจุก่อนสุ่ม) ───
            -- ══════════════════════════════════════════════════════════
            -- อัปเกรดความจุและดวงก่อน: รูมด > รังมด > อาหาร > สปีด > ราชินี > ดวง > สุ่ม > การ์ดพูล
            Config.KaiTanPhase = "[4/8] 🏰 อัปเกรดฐาน: ปลดรูมด > รังมด > สปีด > ราชินี > ดวงสุ่ม > พูลเลเวล (ข้ามถ้าเงินไม่พอ)"
            
            -- 4.1 Add Ant Slots (ปลดล็อกรูมดในรังออโต้เมื่อตังค์พอ Unlock Ant Hole)
            if Config.AutoUnlockAntHoles and not shouldSkipUpgrade("AddAntSlot") then
                autoUnlockAntHoles()
                task.wait(0.12)
            end

            -- 4.2 Expand the Ant Nest (Floor +1) - 巢穴层数 / NestLayer
            tryUpgradeAttribute("NestLayer", "\229\183\162\231\169\180\229\177\130\230\149\176", "NestGui", "Upgrade")

            -- 4.3 Food Gain Multiplier - 蚂蚁攻击力 / AntAttack
            tryUpgradeAttribute("AntAttack", "\232\154\130\232\154\129\230\148\187\229\135\187\229\138\155", "NestGui", "AntAtk")

            -- 4.4 Ant Speed - 蚂蚁移速 / AntSpeed
            tryUpgradeAttribute("AntSpeed", "\232\154\130\232\154\129\231\167\187\233\128\159", "NestGui", "AntSpeed")

            -- 4.5 Ant Queen Level - 蚁后等级 / AntQueenLevel
            tryUpgradeAttribute("AntQueenLevel", "\232\154\129\229\144\142\231\173\137\231\186\167", "SummonGui", "AntQueenLevel")

            -- 4.6 Upgrade Egg Luck - 幸运值 / Luck
            tryUpgradeAttribute("Luck", "\229\185\184\232\191\144\229\128\188", "SummonGui", "RollLuck")

            -- 4.7 Egg Rolls - 单抽数量 / SingleRollCount
            tryUpgradeAttribute("SingleRollCount", "\229\141\149\230\138\189\230\149\176\233\135\143", "SummonGui", "RollNum")

            -- 4.8 PoolLevelUpgrade (อัปเกรดระดับการ์ดพูลเพื่อปลดล็อคมดเก่งขึ้น)
            if not shouldSkipUpgrade("PoolLevelUpgrade") then
                local currentGold = getCurrentPlayerGold()
                local poolLvl = 1
                pcall(function()
                    local PlayerDataHelper = require(ReplicatedStorage.Battle.Game.Helper.PlayerDataHelper)
                    if PlayerDataHelper and PlayerDataHelper.GetPlayerCardPoolLevel then
                        poolLvl = PlayerDataHelper.GetPlayerCardPoolLevel(LocalPlayer.UserId) or 1
                    end
                end)
                local poolCfg = battle_tbpoollevelupgrade and battle_tbpoollevelupgrade[poolLvl]
                local poolCost = poolCfg and tonumber(poolCfg.CostFood or poolCfg.Cost) or 0
                if poolCost > 0 and currentGold < poolCost then
                    markUpgradeUnaffordable("PoolLevelUpgrade", 25)
                else
                    sendEcsCommand("PoolLevelUpgrade", {})
                end
            end
            task.wait(0.12)

            -- ══════════════════════════════════════════════════════════
            -- ─── STEP 5: SMART GACHA & AUTO EQUIP BEST TEAM (สุ่มมดดวงสูงสุด & จัดทีมลงรูมดใหม่) ───
            -- ══════════════════════════════════════════════════════════
            Config.KaiTanPhase = "[5/8] 🎲 สุ่มมดเทพ & กรอง EFF + ออโต้จัดทีมตัวเก่งสุดลงทุกช่อง"
            sendEcsCommand("RollAnt", { Source = "RollModel" })
            sendEcsCommand("RollAnt", { Source = "ProximityPrompt" })
            pcall(function()
                local rph = require(ReplicatedStorage.Battle.Game.Helper.RollPresentationHelper)
                if rph and rph.GetRollPrompt then
                    local p = rph.GetRollPrompt()
                    if p and p.Enabled and fireproximityprompt then
                        fireproximityprompt(p)
                    end
                end
            end)
            task.wait(0.15)
            if Config.AutoEquipBest then
                triggerEquipBest()
            end

            -- ══════════════════════════════════════════════════════════
            -- ─── STEP 6: RESOURCE CONVERTER & TRASH CLEANER (ตู้แปลงทรัพยากร & ทิ้งมดขยะ) ───
            -- ══════════════════════════════════════════════════════════
            -- มดที่ดีที่สุดถูกสวมใส่ลงทีมเรียบร้อยแล้ว มดที่เหลือในกระเป๋าจึงเอาตัวน้อยสุดใส่ตู้ได้ปลอดภัย 100%
            Config.KaiTanPhase = "[6/8] ⚗️ ตู้แปลงทรัพยากร: เอาตัวน้อยที่สุดใส่ก่อน & ดึงคันโยก"
            depositAntsToCompostLowestFirst()
            if not shouldSkipUpgrade("CompostUpgrade") then
                local currentGold = getCurrentPlayerGold()
                local compostCost = nil
                pcall(function()
                    local PlayerDataHelper = require(ReplicatedStorage.Battle.Game.Helper.PlayerDataHelper)
                    if PlayerDataHelper and PlayerDataHelper.GetPlayerCompostLevel and PlayerDataHelper.GetCompostTierConfig then
                        local lvl = PlayerDataHelper.GetPlayerCompostLevel(LocalPlayer.UserId) or 1
                        local cfg = PlayerDataHelper.GetCompostTierConfig(nil, lvl)
                        if cfg and cfg.UpgradePrice then
                            compostCost = tonumber(cfg.UpgradePrice)
                        end
                    end
                end)
                if compostCost and compostCost > 0 and currentGold < compostCost then
                    markUpgradeUnaffordable("CompostUpgrade", 25)
                else
                    sendEcsCommand("CompostUpgrade", {})
                end
            end
            sendEcsCommand("ClaimAntReward", {})
            -- ทิ้งมดขยะที่เหลือหลังผ่านตู้แปลงทรัพยากรเรียบร้อย
            if Config.AutoTrashWeakerAnts then
                discardWeakerAnts()
            end
            task.wait(0.15)

            -- ══════════════════════════════════════════════════════════
            -- ─── STEP 7: ITEMS SHOP & ANT LEVEL-UP (ซื้อไอเท็มร้านค้า & อัปเลเวลมดในทีม) ───
            -- ══════════════════════════════════════════════════════════
            -- 7.1 ซื้อของใน Items Shop ทุกอย่างที่เงินพอ
            if Config.AutoBuyItemsShop then
                Config.KaiTanPhase = "[7/8] 🛒 ซื้อของใน Items Shop: เหมาของทุกชิ้นที่ตังค์พอ"
                autoBuyItemsShop()
                task.wait(0.12)
            end

            -- 7.2 Upgrade Equipped Ants Level (อัปเลเวลมดในทีมถ้าเปิดโหมดไว้)
            if Config.AutoUpgradeAntLevel and not shouldSkipUpgrade("UpgradeEquippedAnt") then
                Config.KaiTanPhase = "[7/8] ⚔️ อัปเลเวลมดที่ใส่อยู่ในทีม (Equipped Ants Level Up)"
                local currentGold = getCurrentPlayerGold()
                local equippedStats = getCurrentEquippedStats()
                local count = math.clamp(equippedStats.EquippedCount or 1, 1, 10)
                for slotIdx = 1, count do
                    local upgradeCost = getEquippedAntUpgradeCost(slotIdx)
                    if upgradeCost and upgradeCost > 0 then
                        if currentGold >= upgradeCost then
                            sendEcsCommand("UpgradeEquippedAnt", { Source = "RoomAntInfoGui", AntIndex = slotIdx })
                            currentGold = currentGold - upgradeCost
                            task.wait(0.06)
                        end
                    end
                end
                task.wait(0.12)
            end

            -- ══════════════════════════════════════════════════════════
            -- ─── STEP 8: ANTI-CRASH & MEMORY HYGIENE (ล้างแคช RAM & ป้องกันแคลช 24/7) ───
            -- ══════════════════════════════════════════════════════════
            Config.KaiTanPhase = "[8/8] 🧹 ล้างแคช RAM & ป้องกันแคลชสะสม (รอบที่ " .. Config.KaiTanCycles .. ")"
            runMemoryHygiene(false)
            if Config.KaiTanCycles % 60 == 0 then
                pcall(function()
                    collectgarbage("collect")
                end)
            end

            Config.KaiTanCycles = Config.KaiTanCycles + 1
        end
    end
end)

