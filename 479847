local function automateStarfallEvent()
    if not Config.AutoStarfallEvent then return end

    -- 1. ตรวจสอบว่ากำลังอยู่ในดันเจี้ยนดาวตก (StarEvent Dungeon) หรือไม่
    local dungeonSessionId = LocalPlayer:GetAttribute("DungeonSessionId")
    if dungeonSessionId then
        pcall(function()
