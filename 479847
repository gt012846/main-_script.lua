-- ══════════════════════════════════════════════════════════════════
-- ทำงาน 3 ชั้น:
-- 1. ดักจับ Hook WuKong.ExecuteQuery ไม่ให้เด้งหน้าต่างซื้อเงินจริง/Robux ขึ้นมาตั้งแต่แรก
-- 2. เมื่อหน้าต่าง CoreGui.PurchasePrompt ปรากฏขึ้น จะค้นหาปุ่ม [X] / Close / Cancel แล้วจำลองคลิกทันที (firesignal + VirtualInputManager)
-- 3. ตรวจจับและปิดหน้าต่างใน PlayerGui หรือ Native Roblox Prompt ทันทีตลอดเวลา 24/7

local function clickGuiButton(btn)
    if not btn then return false end
    local clicked = false

    -- Method 1: firesignal (Executor API)
    if firesignal then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.MouseButton1Down)
        pcall(firesignal, btn.MouseButton1Up)
        pcall(firesignal, btn.Activated)
        clicked = true
    end

    -- Method 2: VirtualInputManager (Hardware mouse click simulation)
    if VirtualInputManager and btn.AbsolutePosition and btn.AbsoluteSize then
        pcall(function()
            local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            if center.X > 0 and center.Y > 0 then
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
                task.wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
                clicked = true
            end
        end)
    end

    -- Method 3: VirtualUser (Fallback)
    if not clicked and VirtualUser and btn.AbsolutePosition and btn.AbsoluteSize then
        pcall(function()
            local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            VirtualUser:Button1Down(Vector2.new(center.X, center.Y), Workspace.CurrentCamera.CFrame)
            task.wait(0.03)
            VirtualUser:Button1Up(Vector2.new(center.X, center.Y), Workspace.CurrentCamera.CFrame)
            clicked = true
        end)
    end

    return clicked
end

local function dismissPurchasePrompt()
    if not Config.AutoClosePurchasePrompt then return false end
    local closedAny = false

    -- 1. Fast Guard Scan CoreGui for PurchasePrompt / PurchasePromptApp
    pcall(function()
        if not CoreGui then return end
        local pp = CoreGui:FindFirstChild("PurchasePrompt") or CoreGui:FindFirstChild("PurchasePromptApp")
        if not pp then
            local robloxGui = CoreGui:FindFirstChild("RobloxGui")
            if robloxGui then pp = robloxGui:FindFirstChild("PurchasePrompt") end
        end

        if pp and (pp:IsA("ScreenGui") or pp:IsA("GuiObject")) and (pp.Enabled ~= false) then
            for _, desc in ipairs(pp:GetDescendants()) do
                if (desc:IsA("ImageButton") or desc:IsA("TextButton")) and desc.Visible and desc.AbsoluteSize.X > 5 and desc.AbsoluteSize.Y > 5 then
                    local name = string.lower(desc.Name)
                    local isClose = false

                    if name:find("close") or name:find("cancel") or name:find("exit") or name:find("dismiss") or name == "x" then
                        isClose = true
                    elseif desc:IsA("TextButton") and (desc.Text == "X" or desc.Text == "x" or desc.Text == "✕" or desc.Text == "✖") then
                        isClose = true
                    elseif desc:IsA("ImageButton") then
                        local img = string.lower(tostring(desc.Image))
                        if img:find("close") or img:find("cross") or img:find("cancel") or img:find("x") then
                            isClose = true
                        end
                    end

                    if isClose then
                        if clickGuiButton(desc) then
                            closedAny = true
                        end
                    end
                end
            end
        end
    end)

    -- 2. Fast Scan PlayerGui for active purchase dialogs (only if visible dialog present)
