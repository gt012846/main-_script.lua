    if cmdName == "PoolLevelUpgrade" or cmdName == "UpgradePlayerAttribute" or cmdName == "AddAntSlot" or cmdName == "UpgradeEquippedAnt" or cmdName == "CompostUpgrade" then
        lastUpgradeCommand = cmdName
        lastUpgradeAttr = payload and payload.AttributeName
