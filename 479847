-- FAST FLAGS & EXTREME GRAPHICS OPTIMIZATION
-- ══════════════════════════════════════════════════════════════════
local FastFlags = {
    ["FFlagDebugDisablePostFx"] = "True",
    ["FFlagDisablePostFx"] = "True",
    ["FIntFRMMinLevel"] = "1",
    ["FIntFRMSpeed"] = "1",
    ["FFlagRenderFixSky"] = "False",
    ["FFlagEnableSkyLight"] = "False",
    ["FFlagDisableSunRays"] = "True",
    ["FFlagDisableShadowmaps"] = "True",
    ["FFlagDisableShadows"] = "True",
    ["FIntRenderShadowIntensity"] = "0",
    ["FFlagGlobalWindEnabled"] = "False",
    ["FFlagEnableProceduralTerrainWater"] = "False",
    ["FIntTerrainArraySliceSize"] = "0",
    ["FIntRenderGrassHeight"] = "0",
    ["FFlagRenderGPUTrassing"] = "False",
    ["FFlagHandleAltEnterFullscreenManually"] = "False",
    ["FIntDebugForceMSAASamples"] = "1",
    ["DFFlagTextureQualityOverrideEnabled"] = "True",
    ["DFIntTextureQualityOverride"] = "0",
}

local function applyFastFlags()
    if not Config.FastFlagsOptimized then return end
    pcall(function()
        local setFlag = setfflag or set_fflag
        if setFlag then
            for flag, val in pairs(FastFlags) do
                pcall(setFlag, flag, tostring(val))
            end
        end
    end)
end

local function boostFPS(enable)
    pcall(function()
        if enable then
            -- 1. นำ FFlags ไปใช้กับเอนจินเกม
            applyFastFlags()

            -- 2. ปิดกราฟิกและเอฟเฟกต์ทั้งหมดตามที่ระบุใน FFlags
            Lighting.GlobalShadows = false
            Lighting.ShadowSoftness = 0
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") then
                    v.Enabled = false
                end
            end
            local ter = Workspace:FindFirstChildOfClass("Terrain")
            if ter then
                ter.WaterWaveSize = 0
                ter.WaterWaveSpeed = 0
                ter.WaterReflectance = 0
                ter.WaterTransparency = 0
                pcall(function() ter.Decoration = false end)
            end
            pcall(function()
                Workspace.GlobalWind = Vector3.zero
            end)
            pcall(function()
                if settings and settings().Rendering then
                    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                end
            end)

            -- 3. ล็อค FPS ตามที่ตั้งค่าไว้ใน Config
            if setfpscap then
                local targetFps = (Config.LockFPS and tonumber(Config.TargetFPS)) or 30
                pcall(setfpscap, targetFps)
            end
        else
            Lighting.GlobalShadows = true
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") then
                    v.Enabled = true
                end
            end
            if setfpscap then
                pcall(setfpscap, 60)
            end
        end
    end)
end

-- Run Fast Flags & FPS Boost immediately on load
task.spawn(function()
    applyFastFlags()
    boostFPS(Config.FPSBoost)
end)

