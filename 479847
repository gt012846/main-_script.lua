-- Comprehensive currency suffix parser (handles K, M, B, T, Qa, Qi, Sx, Sp, Oc, N, D, Ud, Dd, Td, Qt, Qd, Sd, St, Od, Nod, V, Cv)
local function parseFormattedCurrency(str)
    if not str or type(str) ~= "string" or str == "" then return nil end
    local clean = string.gsub(str, "[,%s%$%+]", "")
    if clean == "" then return nil end

    local units = {
        {"cv", 1e66}, {"v", 1e63}, {"nod", 1e60}, {"od", 1e57},
        {"st", 1e54}, {"sd", 1e51}, {"qd", 1e48}, {"qt", 1e45},
        {"td", 1e42}, {"dd", 1e39}, {"ud", 1e36}, {"d", 1e33},
        {"n", 1e30},  {"oc", 1e27}, {"sp", 1e24}, {"sx", 1e21},
        {"qi", 1e18}, {"qa", 1e15}, {"t", 1e12}, {"b", 1e9},
        {"m", 1e6},   {"k", 1e3}
    }

    local lower = string.lower(clean)
    for _, u in ipairs(units) do
        local suffix = u[1]
        local mult = u[2]
        if string.sub(lower, -#suffix) == suffix then
            local numPart = string.sub(clean, 1, -#suffix - 1)
            local n = tonumber(numPart)
            if n then
                return n * mult
            end
        end
    end

    return tonumber(clean)
end

local function formatGoldDisplay(amount)
    amount = tonumber(amount) or 0
    if amount <= 0 then return "0 Gold" end

    local units = {
        {"Cv", 1e66}, {"V", 1e63}, {"Nod", 1e60}, {"Od", 1e57},
        {"St", 1e54}, {"Sd", 1e51}, {"Qd", 1e48}, {"Qt", 1e45},
        {"Td", 1e42}, {"Dd", 1e39}, {"Ud", 1e36}, {"D", 1e33},
        {"N", 1e30},  {"Oc", 1e27}, {"Sp", 1e24}, {"Sx", 1e21},
        {"Qi", 1e18}, {"Qa", 1e15}, {"T", 1e12}, {"B", 1e9},
        {"M", 1e6},   {"K", 1e3}
    }

    for _, u in ipairs(units) do
        if amount >= u[2] then
            return string.format("%.2f %s Gold", amount / u[2], u[1])
        end
    end

    return string.format("%d Gold", math.floor(amount))
end

