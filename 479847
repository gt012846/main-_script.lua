-- 9. SERVER EVENT LISTENER (ROLL RESULTS, AFFORDABILITY & SELLING)
-- ══════════════════════════════════════════════════════════════════
pcall(function()
    if EventBusRemote then
        EventBusRemote.OnClientEvent:Connect(function(eventType, data)
            -- Roll Ant Result: Coordinated EFF Filter & Smart Affordability Engine (Batch-Optimized)
            if eventType == "RollAntResult" and type(data) == "table" then
                Config.Stats.TotalRolls = Config.Stats.TotalRolls + 1
                local results = data.Results or (data.Result and { data.Result }) or {}
                local needEquipBest = false
                local needDismiss = false

                for _, res in ipairs(results) do
                    local claimId = res.ClaimId
                    if not claimId then continue end

                    -- Stars & Special Items: Always claim (Free rewards)
                    if res.PresentationType == "Star" or res.ResultType == "Item" then
                        Config.Stats.TotalStars = Config.Stats.TotalStars + 1
                        claimResult(claimId)
                        continue
                    end

                    local unitId = tostring(res.UnitId or res.Id or "")
                    if not string.find(unitId, "Unit") and tonumber(unitId) then
                        unitId = "Unit" .. tostring(unitId)
                    end
                    local antCost = tonumber(res.Cost or res.Price or (battle_tbunit[unitId] and battle_tbunit[unitId].Price) or 0) or 0
                    local currentGold = getCurrentPlayerGold()
                    local rolledEff = getRolledAntEFF(res)
                    local equippedStats = getCurrentEquippedStats()

                    -- Check if this ant is an upgrade in EFF or fills an empty unlocked slot
                    local isEffUpgrade = false
                    if equippedStats.EquippedCount < equippedStats.MaxSlots then
                        -- Team still has empty slots unlocked! Any ant is an upgrade
                        isEffUpgrade = true
                    elseif equippedStats.MinEFF > 0 then
                        -- Team is full: only considered an upgrade if rolledEff >= weakest equipped ant
                        isEffUpgrade = (rolledEff >= equippedStats.MinEFF)
                    else
                        -- Fallback: no equipped ants detected
                        isEffUpgrade = true
                    end

                    local shouldBuy = true

                    -- 1. Smart EFF Filter: "EFF ถ้ามีน้อยกว่าตัวที่ใช้อยู่ให้ไม่ต้องซื้อ ถ้ามากกว่าให้ซื้อ"
                    if (Config.FilterByEFF or Config.FilterByDamage) and not isEffUpgrade then
                        shouldBuy = false
                        Config.Stats.TotalSkippedWeakerEFF = Config.Stats.TotalSkippedWeakerEFF + 1
                        Config.Stats.TotalRejectedWeaker = Config.Stats.TotalSkippedWeakerEFF
                    end

                    -- 2. Smart Buy Skip: "ตัวไหนที่ตังค์ไม่พอซื้อให้ไม่ต้องซื้อให้ข้ามไปเลย"
                    if shouldBuy and Config.SkipAntIfCannotAfford then
                        if antCost > 0 and currentGold < antCost then
                            shouldBuy = false
                            Config.Stats.TotalSkippedNotEnoughGold = Config.Stats.TotalSkippedNotEnoughGold + 1
                        end
                    end

                    -- Purchase or Clean Skip
                    if shouldBuy then
                        claimResult(claimId)
                        needEquipBest = true
                    else
                        -- ข้ามไปเลยทันที: บันทึก Blacklist และปิด Claim / Prompt ทันทีไม่ให้แย่งกดซื้อ
                        disableRolledClaim(claimId)
                        needDismiss = true
                    end
                end

                -- Batch Trigger (รวบยอดทำทีเดียวต่อชุด ไม่ spawn coroutine ซ้ำซ้อน)
                if needEquipBest and Config.AutoEquipBest then
                    task.delay(0.3, triggerEquipBest)
                end
                if needDismiss and Config.AutoClosePurchasePrompt then
                    task.delay(0.08, dismissPurchasePrompt)
                end
            end

            -- Claim Rolled Ant Result (If server requests Robux prompt or purchase pending, dismiss popup immediately)
            if eventType == "ClaimRolledAntResult" and type(data) == "table" then
                if data.PromptRobuxPurchase or data.Reason == "RobuxPurchasePending" or data.Reason == "NotEnoughGold" then
                    if Config.AutoClosePurchasePrompt then
                        task.delay(0.05, dismissPurchasePrompt)
                    end
                end
            end

            -- Live Sell Multiplier Update
            if (eventType == "SellFoodPriceUpdate" or eventType == "SellPriceUpdate") and type(data) == "table" then
                local mult = tonumber(data.GoldPerFood or data.BaseGoldPerFood or data.FoodSellMultiplier)
                if mult and mult > 0 then
                    Config.CurrentMultiplier = mult
                end
            end

            -- Sell Result
            if (eventType == "SellResuit" or eventType == "SellResult") and type(data) == "table" then
                local gold = tonumber(data.Gold or data.GoldEarned or 0) or 0
                local food = tonumber(data.Food or data.FoodSold or 0) or 0
                Config.Stats.TotalGoldEarned = Config.Stats.TotalGoldEarned + gold
                Config.Stats.TotalFoodSold = Config.Stats.TotalFoodSold + food
                resetUnaffordableSkips()
            end

            -- Items Shop Purchase Result (GearShopResult)
            if eventType == "GearShopResult" and type(data) == "table" then
                if data.Success then
                    Config.Stats.TotalItemsBought = (Config.Stats.TotalItemsBought or 0) + 1
                end
            end

            -- Dungeon rejection feedback ("You have already challenged the dungeon.")
            if (eventType == "DungeonState" and type(data) == "table" and data.reason == "DungeonAlreadyChallenged") or
               (eventType == "StarEventResult" and type(data) == "table" and data.Reason == "DungeonAlreadyChallenged") then
                if onDungeonAlreadyChallengedDetected then
                    onDungeonAlreadyChallengedDetected(lastAttemptedDungeonType, lastAttemptedPrompt)
                end
            end

            -- Server rejection feedback (insufficient funds)
            if type(data) == "table" and (data.Reason == "NotEnoughGold" or data.Success == false) then
                if data.ClaimId then
                    rejectedClaimIds[tostring(data.ClaimId)] = true
                end
                if eventType == "PoolLevelUpgradeResult" then
                    markUpgradeUnaffordable("PoolLevelUpgrade", 25)
                elseif eventType == "UpgradePlayerAttributeResult" then
                    if data.AttributeName then
                        markUpgradeUnaffordable(data.AttributeName, 25)
                    else
                        markUpgradeUnaffordable("AntAttack", 25)
                        markUpgradeUnaffordable("AntSpeed", 25)
                    end
                elseif eventType == "AddAntSlotResult" then
                    markUpgradeUnaffordable("AddAntSlot", 25)
                elseif eventType == "UpgradeEquippedAntResult" then
                    markUpgradeUnaffordable("UpgradeEquippedAnt", 25)
                elseif eventType == "CompostUpgradeResult" then
                    markUpgradeUnaffordable("CompostUpgrade", 25)
                end
            end
        end)
    end
end)

