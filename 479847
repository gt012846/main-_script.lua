            EventBusRemote:FireServer("ECS_COMMAND", cmdName, payload or {})
        else
            local EventBus = require(ReplicatedStorage.Packages.EventBus)
            EventBus.FireServer("ECS_COMMAND", cmdName, payload or {})
        end
    end)
end

