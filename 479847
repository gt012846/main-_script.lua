-- Get minimum attack damage / EFF of currently equipped ants (with 2.5s caching to eliminate CPU lag)
local cachedEquippedStats = nil
local lastEquippedStatsTime = 0

local function getCurrentEquippedStats()
    local now = os.clock()
    if cachedEquippedStats and (now - lastEquippedStatsTime < 2.5) then
        return cachedEquippedStats
    end
    lastEquippedStatsTime = now

    local minEff = math.huge
    local maxEff = 0
    local equippedCount = 0
    local maxSlots = 1

    pcall(function()
        local BackpackModel = require(ReplicatedStorage.UI.Backpack.Model.BackpackModel)
        if BackpackModel then
            -- Ensure backpack data is loaded / refreshed
            if not BackpackModel.BackPackData or not next(BackpackModel:GetData().EquippedBySlot or {}) then
                pcall(function() BackpackModel:Refresh() end)
            end

            -- Read actual unlocked slots from game engine (not hardcoded 10)
            if BackpackModel.GetMaxEquipped then
                local m = BackpackModel:GetMaxEquipped()
                if m and m > 0 then maxSlots = m end
            elseif BackpackModel.GetUnlockedSlotList then
                local list = BackpackModel:GetUnlockedSlotList()
                if list and #list > 0 then maxSlots = #list end
            end

            local entries = BackpackModel.BuildEquippedEntries and BackpackModel:BuildEquippedEntries() or {}
            for _, entry in pairs(entries) do
                if entry then
                    equippedCount = equippedCount + 1
                    local eff = tonumber(entry.Attack) or 0
                    if eff <= 0 and entry.V and BackpackModel.DecodeBackpackValue then
                        local uIdx, tagId, exp = BackpackModel:DecodeBackpackValue(entry.V)
                        local uKey = "Unit" .. tostring(uIdx)
                        local baseAtk = battle_tbunit[uKey] and battle_tbunit[uKey].Attack or 0
                        local tagMul = battle_tbtag[tagId] and battle_tbtag[tagId].Mul or 1
                        eff = math.ceil(baseAtk * tagMul)
                    end
                    if eff > 0 then
                        if eff < minEff then minEff = eff end
                        if eff > maxEff then maxEff = eff end
                    end
                end
            end
        end
    end)

    -- Fallback via BackPackStore directly if BackpackModel cache was empty
    if equippedCount == 0 then
        pcall(function()
            local BackPackStore = require(ReplicatedStorage.WuKongHooks.BackPackStore)
            if BackPackStore and BackPackStore.Load then
                local success, data = pcall(BackPackStore.Load, LocalPlayer.UserId)
                if success and type(data) == "table" then
                    if type(data.UnlockedAntSlots) == "table" then
                        local c = 0
                        for _, v in pairs(data.UnlockedAntSlots) do
                            if v then c = c + 1 end
                        end
                        if c > 0 then maxSlots = c end
                    end
                    if type(data.EquippedBySlot) == "table" then
                        for _, eq in pairs(data.EquippedBySlot) do
                            if eq and eq.V then
                                equippedCount = equippedCount + 1
                                local v = tonumber(eq.V) or 0
                                if v > 0 then
                                    local v24 = math.floor(v) - 1
                                    local v25 = math.floor(v24 / 512)
                                    local uIdx = math.floor(v25 / 64) + 1
                                    local tagId = v25 % 64
                                    local uKey = "Unit" .. tostring(uIdx)
                                    local baseAtk = battle_tbunit[uKey] and battle_tbunit[uKey].Attack or 0
                                    local tagMul = battle_tbtag[tagId] and battle_tbtag[tagId].Mul or 1
                                    local eff = math.ceil(baseAtk * tagMul)
                                    if eff < minEff then minEff = eff end
                                    if eff > maxEff then maxEff = eff end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    -- Player attribute fallback for unlocked slots
    pcall(function()
        local attrSlots = tonumber(LocalPlayer:GetAttribute("MaxAntSlot") or LocalPlayer:GetAttribute("UnlockedAntSlots"))
        if attrSlots and attrSlots > maxSlots then
            maxSlots = attrSlots
        end
    end)

    if minEff == math.huge then
        minEff = 0
    end
    if maxSlots < 1 then
        maxSlots = math.max(equippedCount, 1)
    end

    cachedEquippedStats = {
        MinEFF = minEff,
        MaxEFF = maxEff,
        MinAttack = minEff,
        MaxAttack = maxEff,
        EquippedCount = equippedCount,
        MaxSlots = maxSlots,
    }
    return cachedEquippedStats
end

-- Calculate Exact EFF (Effective Damage) of a rolled ant with full mutation accuracy
local function getRolledAntEFF(res)
    local unitId = tostring(res.UnitId or res.Id or "")
    if not string.find(unitId, "Unit") and tonumber(unitId) then
        unitId = "Unit" .. tostring(unitId)
    end

    -- Extract mutation TagId from V (packed formula) if available
    local tagId = 0
    local rawV = tonumber(res.V)
    if rawV and rawV > 0 then
        local v24 = math.floor(rawV) - 1
        local v25 = math.floor(v24 / 512)
        local uIdx = math.floor(v25 / 64) + 1
        tagId = v25 % 64
        if unitId == "" or unitId == "Unit" then
            unitId = "Unit" .. tostring(uIdx)
        end
    end

    local baseAtk = 0
    if battle_tbunit and battle_tbunit[unitId] then
        baseAtk = tonumber(battle_tbunit[unitId].Attack) or 0
    end

    -- Tag multiplier resolution (handles tagId, textual Tag names, and battle_tbtag)
    local tagMul = 1
    if tagId > 0 and battle_tbtag and battle_tbtag[tagId] and battle_tbtag[tagId].Mul then
        tagMul = tonumber(battle_tbtag[tagId].Mul) or 1
    else
        local explicitTagId = tonumber(res.TagId)
        if explicitTagId and explicitTagId > 0 and battle_tbtag and battle_tbtag[explicitTagId] then
            tagMul = tonumber(battle_tbtag[explicitTagId].Mul) or 1
        elseif type(res.Tag) == "string" and res.Tag ~= "" then
            local tagLower = string.lower(res.Tag)
            if string.find(tagLower, "starlight") then tagMul = 5.0
            elseif string.find(tagLower, "petal") then tagMul = 3.0
            elseif string.find(tagLower, "rainbow") then tagMul = 2.25
            elseif string.find(tagLower, "candy") then tagMul = 2.0
            elseif string.find(tagLower, "bubblegum") then tagMul = 1.75
            elseif string.find(tagLower, "leaf") then tagMul = 1.35
            end
        end
    end

    local eff = math.ceil(baseAtk * tagMul)
    pcall(function()
        local helper = require(ReplicatedStorage.Helper.AntAttributeHelper)
        if helper and helper.GetAttackByExp then
            eff = helper.GetAttackByExp(baseAtk, 0, tagMul)
        end
    end)
    return eff
end

