-- 9.5. STARFALL EVENT AUTOMATION (น้ำพุดาวตก 0/30 & ดันเจี้ยน & ล็อกอิน)
-- ══════════════════════════════════════════════════════════════════
local lastSignInClaimTime = 0

local function findStarEnterPrompt()
    if cachedStarEnterPrompt and cachedStarEnterPrompt.Parent and cachedStarEnterPrompt.Enabled then
        return cachedStarEnterPrompt
    end

    local starModel = Workspace:FindFirstChild("StarEvent")
    if starModel then
        local enterPart = starModel:FindFirstChild("Enterpromt", true)
        if enterPart then
            if enterPart:IsA("ProximityPrompt") then
                cachedStarEnterPrompt = enterPart
                return enterPart
            end
            local p = enterPart:FindFirstChildWhichIsA("ProximityPrompt", true)
            if p then
                cachedStarEnterPrompt = p
                return p
            end
        end

        for _, p in ipairs(starModel:GetDescendants()) do
            if p:IsA("ProximityPrompt") then
                local act = string.lower(p.ActionText or "")
                local name = string.lower(p.Name or "")
                local pName = string.lower(p.Parent and p.Parent.Name or "")
                if string.find(act, "enter") or string.find(name, "enter") or string.find(pName, "enter") then
                    cachedStarEnterPrompt = p
                    return p
                end
            end
        end
    end

    -- Fallback: ค้นหา ProximityPrompt เฉพาะที่อยู่ใกล้น้ำพุในรัศมี 45 สตัดเท่านั้น (ป้องกันไปหยิบก้อนหินหอยทาก)
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Position - FOUNTAIN_PAD_CFRAME.Position).Magnitude <= 45 then
            local p = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if p and (string.find(string.lower(p.ActionText or ""), "enter") or string.find(string.lower(p.Name or ""), "enter")) then
                cachedStarEnterPrompt = p
                return p
            end
        end
    end

    return nil
end

local function findSnailEnterPrompt()
    if cachedSnailEnterPrompt and cachedSnailEnterPrompt.Parent and cachedSnailEnterPrompt.Enabled then
        return cachedSnailEnterPrompt
    end

    local snailModel = Workspace:FindFirstChild("TravelSnail") or Workspace:FindFirstChild("Snail")
    if snailModel then
        for _, p in ipairs(snailModel:GetDescendants()) do
            if p:IsA("ProximityPrompt") then
                local act = string.lower(p.ActionText or "")
                local name = string.lower(p.Name or "")
                local pName = string.lower(p.Parent and p.Parent.Name or "")
                if string.find(act, "enter") or string.find(name, "enter") or string.find(pName, "enter") then
                    cachedSnailEnterPrompt = p
                    return p
                end
            end
        end
    end

    return nil
end

local function findStarPrompt(promptType)
    if promptType == "Enter" then
        return findStarEnterPrompt()
    end
    if promptType == "Flip" and cachedFlipPrompt and cachedFlipPrompt.Parent then
        return cachedFlipPrompt
    end

    local starModel = Workspace:FindFirstChild("StarEvent")
    if starModel then
        local targetPart = starModel:FindFirstChild("Flippromt", true)
        if targetPart then
            if targetPart:IsA("ProximityPrompt") then return targetPart end
            local p = targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)
            if p then return p end
        end

        for _, p in ipairs(starModel:GetDescendants()) do
            if p:IsA("ProximityPrompt") then
                local act = string.lower(p.ActionText or "")
                local pName = string.lower(p.Parent and p.Parent.Name or "")
                if string.find(act, "flip") or string.find(pName, "flip") or string.find(act, "star") then
                    return p
                end
            end
        end
    end

    return nil
end

local function triggerStarPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    pcall(function()
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 99999
        prompt.RequiresLineOfSight = false
    end)

    local triggered = false
    if fireproximityprompt then
        pcall(fireproximityprompt, prompt)
        triggered = true
    end
    if firesignal then
        pcall(firesignal, prompt.Triggered, LocalPlayer)
        triggered = true
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
        triggered = true
    end)
    return triggered
end

