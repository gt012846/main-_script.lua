            -- คลิกปุ่ม Start บนหน้าจอ GUI (PlayerGui.HUDContainer.DungeonPanel.StartBtn)
            local hud = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("HUDContainer")
            local dungeonPanel = hud and hud:FindFirstChild("DungeonPanel")
            local startBtn = dungeonPanel and dungeonPanel:FindFirstChild("StartBtn")
            if startBtn and startBtn.Visible then
                if firesignal then
                    pcall(firesignal, startBtn.Activated)
                    pcall(firesignal, startBtn.MouseButton1Click)
                end
                startBtn.Visible = false
            end
        end)

        -- ออโต้เก็บ TimeCoin / เหรียญดรอปในดันเจี้ยน
        pcall(function()
            for _, coin in ipairs(Workspace:GetChildren()) do
                if coin.Name == "TimeCoin" or coin:GetAttribute("CoinId") then
                    local coinId = coin:GetAttribute("CoinId") or 1
                    sendEcsCommand("DungeonCommand", { Action = "PickupTimeCoin", SessionId = dungeonSessionId, CoinId = coinId })
                end
            end
        end)
        return
    end

    -- 2. ตรวจสอบว่าน้ำพุเปิดประตูมิติแล้วหรือไม่ (ภาพประตูแสดง + Enterprompt พร้อม -> เข้าดันเจี้ยน)
    local portalOpen = isStarPortalVortexVisible()
    if portalOpen and not dungeonAlreadyChallengedActive then
        local enterPrompt = findStarEnterPrompt()
        if enterPrompt and enterPrompt.Enabled then
            enterStarDungeon()
            return
        end
    end

    -- 3. ถ้าภาพประตูหาย (หรือกำลังสะสมดาว) -> เอาดาวใส่ 30 ดวงต่อเนื่องจนครบ
    local starCount = 0
    pcall(function()
        local BackpackModel = require(ReplicatedStorage.UI.Backpack.Model.BackpackModel)
        if BackpackModel and BackpackModel.GetItemCount then
            starCount = BackpackModel:GetItemCount("Star") or 0
        end
    end)
    local isHoldingStar = (LocalPlayer:GetAttribute("BackpackHeldKind") == "Item") and (LocalPlayer:GetAttribute("BackpackHeldItemId") == "Star")

    if starCount > 0 or isHoldingStar then
        submitAllStarsToFountain()
        -- ถ้าหยอดดาวครบ 30 ดวงจนภาพประตูเปิดขึ้นมาใหม่แล้ว ให้เข้าดันเจี้ยนทันที
        local postEnterPrompt = findStarEnterPrompt()
        if postEnterPrompt and postEnterPrompt.Enabled and isStarPortalVortexVisible() then
            enterStarDungeon()
            return
        end
    end

    -- 4. เคลมอีเวนต์เช็คอิน 14 วัน (Starfall Event Sign In)
    local now = os.time()
    if now - lastSignInClaimTime >= 60 then
        lastSignInClaimTime = now
        pcall(function()
            local WuKong = require(ReplicatedStorage.WuKong)
            if WuKong and WuKong.ExecuteAction then
                for day = 1, 14 do
                    WuKong:ExecuteAction("/功能商人/活动签到?购买", "__null__", "__null__", { DayId = day })
                end
            end
        end)
    end

    -- 5. ตรวจสอบและซื้อของในร้านค้า Rewards อีเวนต์ดาวตก (Starwing Ant 2,400 เหรียญ)
    if Config.AutoBuyStarShop then
        pcall(checkAndBuyStarShopItems)
    end
end

