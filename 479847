local function parsePriceString(str)
    if not str then return nil end
    local s = tostring(str)
    local directNum = tonumber(s)
    if directNum then return directNum end
    local clean = string.gsub(s, "[,%$%s]", "")
    local numPart, unit = string.match(clean, "^([%d%.]+)%s*([A-Za-z]*)$")
    if numPart then
        local val = tonumber(numPart) or 0
        unit = string.upper(unit or "")
        if unit == "K" then val = val * 1e3
        elseif unit == "M" then val = val * 1e6
        elseif unit == "B" then val = val * 1e9
        elseif unit == "T" then val = val * 1e12
        elseif unit == "QA" then val = val * 1e15
        elseif unit == "QI" then val = val * 1e18
        end
        return val
    end
    return nil
end

local function findNextBuyableAntSlot()
    local roomIdx = tonumber(LocalPlayer:GetAttribute("RoomIndex") or 1) or 1
    local room = Workspace:FindFirstChild("Rooms") and Workspace.Rooms:FindFirstChild(tostring(roomIdx))
    
    local foundSlotIndex = nil
    local foundPrompt = nil
    local foundPrice = nil
    
    -- 1. Scan player room's AntPos for slot instance with SlotBuyable == true
    if room and room:FindFirstChild("AntPos") then
        local buyableSlots = {}
        for _, child in ipairs(room.AntPos:GetChildren()) do
            local idx = tonumber(child.Name)
            if idx and child:GetAttribute("SlotBuyable") == true then
                table.insert(buyableSlots, { SlotIndex = idx, Object = child })
            end
            for _, subChild in ipairs(child:GetChildren()) do
                local subIdx = tonumber(subChild.Name)
                if subIdx and subChild:GetAttribute("SlotBuyable") == true then
                    table.insert(buyableSlots, { SlotIndex = subIdx, Object = subChild })
                end
            end
        end
        if #buyableSlots > 0 then
            table.sort(buyableSlots, function(a, b) return a.SlotIndex < b.SlotIndex end)
            foundSlotIndex = buyableSlots[1].SlotIndex
            local p = buyableSlots[1].Object:FindFirstChildWhichIsA("ProximityPrompt", true)
            if p then foundPrompt = p end
        end
    end
    
    -- 2. Scan for any ProximityPrompt in the room with ActionText == "Unlock" or inside AddAntNum
    if room then
        for _, desc in ipairs(room:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                local action = string.lower(desc.ActionText or "")
                local name = string.lower(desc.Name or "")
                local parentName = string.lower(desc.Parent and desc.Parent.Name or "")
                if action == "unlock" or name == "unlockprompt" or string.find(parentName, "addantnum") then
                    foundPrompt = desc
                    if not foundPrice and desc.ObjectText then
                        foundPrice = parsePriceString(desc.ObjectText)
                    end
                    if not foundSlotIndex then
                        local pObj = desc.Parent
                        while pObj and pObj ~= room do
                            local n = tonumber(pObj.Name)
                            if n and n > 0 and n <= 45 then
                                foundSlotIndex = n
                                break
                            end
                            pObj = pObj.Parent
                        end
                    end
                end
            end
        end
    end
    
    -- 3. Fallback slot index using player attributes or config
    local maxSlotsAttr = tonumber(LocalPlayer:GetAttribute("MaxAntSlots"))
    if not foundSlotIndex then
        if maxSlotsAttr and maxSlotsAttr > 0 then
            foundSlotIndex = maxSlotsAttr + 1
        else
            foundSlotIndex = 2
        end
    end
    
    -- 4. Determine price
    if not foundPrice or foundPrice <= 0 then
        local cfg = (battle_tbnestunlock and (battle_tbnestunlock[foundSlotIndex] or battle_tbnestunlock[maxSlotsAttr or 1]))
        if cfg and cfg.Price then
            foundPrice = tonumber(cfg.Price) or 0
        end
    end
    
    return {
        RoomIndex = roomIdx,
        SlotIndex = foundSlotIndex,
        Prompt = foundPrompt,
        Price = foundPrice or 0
    }
end

local function getAntHoleStatus()
    local roomIdx = tonumber(LocalPlayer:GetAttribute("RoomIndex") or 1) or 1
    local currentSlots = tonumber(LocalPlayer:GetAttribute("MaxAntSlots")) or 0
    local target = findNextBuyableAntSlot()
    local slotIdx = target and target.SlotIndex or (currentSlots + 1)
    local price = target and target.Price or 0
    if price <= 0 and battle_tbnestunlock and battle_tbnestunlock[slotIdx] then
        price = tonumber(battle_tbnestunlock[slotIdx].Price) or 0
    end
    local currentGold = getCurrentPlayerGold()
    local canAfford = (price > 0 and currentGold >= price) or (price == 0)
    return {
        RoomIndex = roomIdx,
        CurrentSlots = currentSlots,
        NextSlot = slotIdx,
        Price = price,
        CurrentGold = currentGold,
        CanAfford = canAfford,
        IsMax = (currentSlots >= 45 or slotIdx > 45)
    }
end

local lastUnlockAttemptTime = 0

local function autoUnlockAntHoles()
    if not Config.AutoUnlockAntHoles then return false end
    if shouldSkipUpgrade("AddAntSlot") then return false end
    
    local now = os.clock()
    if now - lastUnlockAttemptTime < 0.3 then return false end
    lastUnlockAttemptTime = now
    
    local target = findNextBuyableAntSlot()
    if not target or not target.SlotIndex or target.SlotIndex > 45 then
        markUpgradeUnaffordable("AddAntSlot", 30)
        return false
    end
    
    local currentGold = getCurrentPlayerGold()
    local price = target.Price or 0
    
    -- ถ้าเงินไม่พอ ข้ามชั่วคราวเพียง 10 วินาที (ไม่บล็อก 999999 เด็ดขาด)
    if price > 0 and currentGold < price then
        markUpgradeUnaffordable("AddAntSlot", 10)
        return false
    end
    
    local roomIdx = target.RoomIndex
    local slotIdx = target.SlotIndex
    local didTrigger = false
    
    -- Layer 1: Fire ProximityPrompt in room
    if target.Prompt and target.Prompt.Parent and target.Prompt.Enabled then
        pcall(function()
            target.Prompt.Enabled = true
            target.Prompt.HoldDuration = 0
            target.Prompt.MaxActivationDistance = 99999
            target.Prompt.RequiresLineOfSight = false
            if fireproximityprompt then
                pcall(fireproximityprompt, target.Prompt)
            end
            if firesignal then
                pcall(firesignal, target.Prompt.Triggered, LocalPlayer)
            end
            pcall(function()
                target.Prompt:InputHoldBegin()
                task.wait(0.04)
                target.Prompt:InputHoldEnd()
            end)
            didTrigger = true
        end)
    end
    
    -- Layer 2: Send Direct ECS Commands (both RoomAntInfoGui and ProximityPrompt sources)
    sendEcsCommand("AddAntSlot", { Source = "RoomAntInfoGui", RoomIndex = roomIdx, SlotIndex = slotIdx })
    sendEcsCommand("AddAntSlot", { Source = "ProximityPrompt", RoomIndex = roomIdx, SlotIndex = slotIdx })
    didTrigger = true
    
    -- Layer 3: Click UI "Unlock" button in PlayerGui only if prompt window is open
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local modalWindow = pg and (pg:FindFirstChild("RoomAntInfoGui") or pg:FindFirstChild("CommonPrompt") or pg:FindFirstChild("ModalPrompt"))
        if modalWindow then
            for _, desc in ipairs(modalWindow:GetDescendants()) do
                if (desc:IsA("TextButton") or desc:IsA("ImageButton")) and desc.Visible then
                    local p = desc.Parent
                    local isUnlockBtn = false
                    if string.lower(desc.Name) == "imagebutton" or string.find(string.lower(desc.Name), "unlock") then
                        local frame = p and p.Parent
                        if frame and frame:FindFirstChild("Title") and string.find(string.lower(frame.Title.Text or ""), "unlock ant hole") then
                            isUnlockBtn = true
                        end
                    end
                    if isUnlockBtn and firesignal then
                        pcall(firesignal, desc.Activated)
                    end
                end
            end
        end
    end)
    
    if didTrigger then
        Config.Stats.TotalAntHolesUnlocked = (Config.Stats.TotalAntHolesUnlocked or 0) + 1
        return true
    end
    return false
end

