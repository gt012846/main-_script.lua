-- 9.5.2. WORLD CAVE PET DUNGEON AUTOMATION (ถ้ำบอสสัตว์เลี้ยงตามแมพ ดร็อปไข่)
-- ══════════════════════════════════════════════════════════════════
findPetDungeonPrompt = function()
    -- 1. ตรวจสอบจากตารางแคช ProximityPrompt ของถ้ำบอส
    for prompt, model in pairs(cachedPetDungeonPrompts) do
        if prompt and prompt.Parent and prompt.Enabled then
            local actualModel = model
            if not (actualModel and actualModel.Parent) then
                actualModel = prompt:FindFirstAncestorWhichIsA("Model")
            end
            local entranceId = (actualModel and actualModel:GetAttribute("DungeonEntranceId")) or tostring(actualModel or prompt)
            if not challengedPetDungeonIds[entranceId] then
                return prompt, actualModel
            end
        else
            cachedPetDungeonPrompts[prompt] = nil
        end
    end

    -- 2. ตรวจสอบโดยตรงในโฟลเดอร์ Workspace.DungeonEntrances
    local entrancesFolder = Workspace:FindFirstChild("DungeonEntrances")
    if entrancesFolder then
        for _, model in ipairs(entrancesFolder:GetChildren()) do
            if model:IsA("Model") then
                local entranceId = model:GetAttribute("DungeonEntranceId") or tostring(model)
                if not challengedPetDungeonIds[entranceId] then
                    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and prompt.Enabled then
                        cachedPetDungeonPrompts[prompt] = model
                        return prompt, model
                    end
                end
            end
        end
    end

    -- 3. ตรวจสอบโมเดล PetDungeonEntrance หรือโมเดลที่มี DungeonEntranceId ใน Workspace
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and (obj:GetAttribute("DungeonEntranceId") or obj.Name == "PetDungeonEntrance" or string.find(string.lower(obj.Name), "petdungeon")) then
            local entranceId = obj:GetAttribute("DungeonEntranceId") or tostring(obj)
            if not challengedPetDungeonIds[entranceId] then
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled then
                    cachedPetDungeonPrompts[prompt] = obj
                    return prompt, obj
                end
            end
        end
    end

    return nil, nil
end

enterPetDungeon = function()
    local prompt, model = findPetDungeonPrompt()
    if not prompt or not prompt.Enabled then
        return false
    end

    local actualModel = model or prompt:FindFirstAncestorWhichIsA("Model")
    local entranceId = (actualModel and actualModel:GetAttribute("DungeonEntranceId")) or tostring(actualModel or prompt)
    if challengedPetDungeonIds[entranceId] then
        return false
    end

    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if not hrp then return false end

    -- หาพิกัดหน้าปากถ้ำดันเจี้ยน
    local targetCFrame = nil
    if prompt.Parent and prompt.Parent:IsA("BasePart") then
        targetCFrame = prompt.Parent.CFrame + Vector3.new(0, 1.5, 0)
    elseif actualModel and actualModel:IsA("Model") then
        targetCFrame = actualModel:GetPivot() + Vector3.new(0, 1.5, 0)
    end

    if not targetCFrame then return false end

    lastAttemptedDungeonType = "Pet"
    lastAttemptedPrompt = prompt
    lastDungeonTypeEntered = "Pet"

    -- วาร์ปมาหน้าปากถ้ำทันที
    pcall(function()
        hrp.CFrame = targetCFrame
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)
    task.wait(0.2)

    -- บังคับปลดล็อก ProximityPrompt ให้กดติดแบบ Zero Delay
    pcall(function()
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 99999
        prompt.RequiresLineOfSight = false
    end)

    if fireproximityprompt then
        pcall(fireproximityprompt, prompt)
    end
    if firesignal then
        pcall(firesignal, prompt.Triggered, LocalPlayer)
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end)

    -- รอตรวจจับ DungeonSessionId เมื่อเซิร์ฟเวอร์ดึงตัวเข้าดันเจี้ยน
    local entered = false
    for _ = 1, 15 do
        task.wait(0.1)
        local sess = LocalPlayer:GetAttribute("DungeonSessionId")
        if sess then
            entered = true
            Config.Stats.TotalDungeonsEntered = (Config.Stats.TotalDungeonsEntered or 0) + 1
            challengedPetDungeonIds[entranceId] = true
            pcall(function()
                local EventBus = require(ReplicatedStorage.Packages.EventBus)
                EventBus.Fire("DungeonStartRequested")
                sendEcsCommand("DungeonCommand", { Action = "Start", SessionId = sess })
            end)
            break
        end

        -- ถ้าเซิร์ฟเวอร์แจ้งเตือนว่าลงไปแล้ว
        if challengedPetDungeonIds[entranceId] then
            break
        end
    end

    -- สแกนดู Alert บนหน้าจอเฉพาะใน NezaAlertGui ว่าติดข้อความ "already challenged" หรือไม่
    if not entered then
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local alertGui = pg and (pg:FindFirstChild("NezaAlertGui") or pg:FindFirstChild("alert"))
            if alertGui then
                for _, v in ipairs(alertGui:GetDescendants()) do
                    if v:IsA("TextLabel") and string.find(string.lower(v.Text or ""), "already challenged") then
                        onDungeonAlreadyChallengedDetected("Pet", prompt)
                        break
                    end
                end
            end
        end)
    end

    return entered
end

