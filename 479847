                    if starCount > 0 or isHoldingStar then
                        Config.KaiTanPhase = "[1/8] 🌟 ภาพประตูหาย (คูลดาวน์เสร็จ): เอาดาวใส่ 30 ดวงเปิดประตูลงซ้ำ!"
